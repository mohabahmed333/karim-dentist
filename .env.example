# Canonical public origin — used for metadataBase, canonical tags, hreflang,
# sitemap.xml, robots.txt, llms.txt, and the public JSON API.
# No trailing slash. On Vercel this falls back to the deployment URL if unset,
# but production MUST set it explicitly or canonicals point at a vercel.app host.
NEXT_PUBLIC_SITE_URL=https://thedentallounge.com

# Supabase — karim-dentist
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Management API PAT — required for /admin/usage database, egress, and analytics.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# File-storage quota for admin Overview (free=1GB, pro/team=100GB).
SUPABASE_PLAN=free
# Optional override in bytes if the org has a custom enterprise quota.
# SUPABASE_STORAGE_QUOTA_BYTES=

# Vercel Hobby usage on /admin/usage (100GB transfer, 1M edge requests, 1M invocations).
# Create a token at https://vercel.com/account/tokens
# VERCEL_ORG_ID and VERCEL_PROJECT_ID are set automatically on Vercel; copy them locally.
VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Optional: local notes only (app does not read these)
# ADMIN_EMAIL=admin@dentallounge.local
# ADMIN_PASSWORD=DentalLounge2026!

# AI providers. Every AI feature asks one chain of models, top to bottom, and
# the first one with quota left answers. Each provider has its own free tier
# and its own daily cap, which is the point: when one runs out the next one's
# is untouched. Set as many as you have — one is enough to work, more is what
# keeps the assistant answering after a busy day.
#
# Order: Gemini → Mistral → Cerebras → Groq. Every model in it handles Arabic.
#
# PRIVACY: on the free tiers Google and Mistral may use prompts to improve
# their products, and patient WhatsApp messages pass through here. Use paid
# tiers, or drop those two from the chain, if that is not acceptable.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
MISTRAL_API_KEY=       # https://console.mistral.ai
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
GROQ_API_KEY=          # https://console.groq.com
# Optional: override the whole order, comma-separated `provider:model`.
# AI_MODEL_CHAIN=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
# Optional: override just the preferred Groq model (default openai/gpt-oss-120b)
# GROQ_MODEL=
# Optional: self-hosted LibreTranslate for Customize AR→EN auto-fill
# LIBRETRANSLATE_URL=http://localhost:5000/translate

# Kapso WhatsApp (Front desk inbox) — server only
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_BUSINESS_ACCOUNT_ID=
# KAPSO_API_BASE_URL=https://api.kapso.ai

# WhatsApp AI auto-responder. Ships disabled: enable it in the DB
# (whatsapp_ai_settings.mode) — there is deliberately no env kill switch to
# forget about. Booking writes are a second, separate switch.
# Shared secret for the Vercel cron that sweeps interrupted auto-reply jobs.
CRON_SECRET=
