# Supabase — karim-dentist
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Management API PAT — required for /admin/usage database, egress, and analytics.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# File-storage quota for admin Overview (free=1GB, pro/team=100GB).
SUPABASE_PLAN=free
# Optional override in bytes if the org has a custom enterprise quota.
# SUPABASE_STORAGE_QUOTA_BYTES=

# Optional: local notes only (app does not read these)
# ADMIN_EMAIL=admin@dentallounge.local
# ADMIN_PASSWORD=DentalLounge2026!

# Groq free API (https://console.groq.com) — AI assist on clinical workspace
GROQ_API_KEY=
# Optional: self-hosted LibreTranslate for Customize AR→EN auto-fill
# LIBRETRANSLATE_URL=http://localhost:5000/translate

# Kapso WhatsApp (Front desk inbox) — server only
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# KAPSO_API_BASE_URL=https://api.kapso.ai
